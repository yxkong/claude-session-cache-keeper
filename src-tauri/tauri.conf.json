{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CacheKeeper",
  "version": "../package.json",
  "identifier": "io.yxkong.cachekeeper",
  "plugins": { "updater": { "pubkey": "" } },
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run build",
    "frontendDist": "../dist/renderer"
  },
  "app": {
    "windows": [{ "label": "main", "title": "CacheKeeper · by yxkong", "width": 1080, "height": 820, "minWidth": 930, "minHeight": 670, "backgroundColor": "#F3FAFA" }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": ["../assets/icons/app.icns", "../assets/icons/app.ico", "../assets/icons/icon-128.png"],
    "resources": { "../build/resources/": "resources/" },
    "macOS": { "minimumSystemVersion": "12.0" },
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["SimpChinese", "English"], "displayLanguageSelector": true } }
  }
}
