{
  "name": "claude-session-cache-keeper",
  "productName": "CacheKeeper",
  "version": "0.4.0",
  "description": "按会话管理 Claude Code 缓存续热 · by yxkong",
  "author": "yxkong",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "icons": "node scripts/icons.mjs",
    "build": "node --experimental-strip-types scripts/build.mjs",
    "start": "tauri dev",
    "test": "node scripts/test.mjs",
    "test:plugin": "node scripts/test.mjs --plugin",
    "package": "node scripts/package.mjs",
    "verify": "node scripts/verify-release.mjs",
    "release:metadata": "node scripts/release-metadata.mjs",
    "test:rust": "cargo build --locked --manifest-path src-tauri/Cargo.toml --example bridge-contract && cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "test:all": "npm test && npm run test:rust && npm run test:plugin"
  },
  "dependencies": {
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/cli": "2.12.4",
    "cross-spawn": "7.0.6",
    "esbuild": "0.28.2",
    "jsdom": "27.4.0",
    "png-to-ico": "3.0.2",
    "sharp": "0.35.5"
  }
}
